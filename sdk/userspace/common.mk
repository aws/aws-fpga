#
# Shared build settings for the SDK userspace libraries and tools.
#
# Each including Makefile must set TOP to the relative path of sdk/userspace
# before the include, e.g.:
#
#     TOP = ../..
#     include $(TOP)/common.mk
#
# Overridable from the environment or the make command line:
#   CC, AR, CROSS_COMPILE   toolchain
#   OPT                     optimization level
#   CONFIG_LOGLEVEL         SDK logging verbosity
#   EXTRA_CPPFLAGS          extra preprocessor defines (used by mkall_fpga_mgmt_tools.sh)
#

TOPINC_PATH = $(TOP)/include
FPGAHALINC_PATH = $(TOPINC_PATH)/hal
LIB_PATH = $(TOP)/lib
LIB_SO_PATH = $(LIB_PATH)/so

# Toolchain. Left overridable so `make CC=clang` and CROSS_COMPILE= both work.
# make predefines CC and AR (origin "default"), so `?=` would never assign them.
ifeq ($(origin CC),default)
CC = $(CROSS_COMPILE)gcc
endif
ifeq ($(origin AR),default)
AR = $(CROSS_COMPILE)ar
endif

OPT ?= -O0
STD ?= -std=gnu99
CONFIG_LOGLEVEL ?= 1

WARN = -Wall -Werror -Wextra -Wno-parentheses -Wstrict-prototypes \
       -Wmissing-prototypes

# Header dependency tracking. Without this, editing a header rebuilds nothing
# and the build silently links objects with mismatched struct layouts.
DEPFLAGS = -MMD -MP

CPPFLAGS += $(INCLUDES) -DCONFIG_LOGLEVEL=$(CONFIG_LOGLEVEL) $(EXTRA_CPPFLAGS)
CFLAGS += $(OPT) $(STD) -g $(WARN) $(DEPFLAGS)

# Files matching *.d are generated by $(DEPFLAGS) alongside each object.
DEPS = $(OBJ:.o=.d)

%.o: %.c
	$(CC) $(CPPFLAGS) $(CFLAGS) -c -o $@ $<

.PHONY: all clean
